{
    "name": "portfolio-antigravity",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev": "npm run dev:api & npm run dev:web",
        "dev:web": "npm run dev --workspace=web",
        "dev:api": "npm run dev --workspace=api",
        "build:web": "npm run build --workspace=web && rm -rf dist && mkdir -p dist && cp -r apps/web/dist/* dist/",
        "build": "npm run build --workspace=web && rm -rf dist && mkdir -p dist && cp -r apps/web/dist/* dist/",
        "db:push": "npx drizzle-kit push --config=apps/api/drizzle.config.ts",
        "db:seed": "npm run db:seed --workspace=api"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "better-auth": "^1.2.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "drizzle-orm": "^0.45.2",
        "express": "^4.21.0",
        "postgres": "^3.4.5"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/node": "^22.0.0",
        "drizzle-kit": "^0.31.4",
        "supertest": "^7.2.2",
        "tsx": "^4.19.0",
        "typescript": "^5.7.0"
    }
}
